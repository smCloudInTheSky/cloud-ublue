{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
  ],

  "rebaseWhen": "never",

  "packageRules": [
    {
      "description": "Auto-merge pin, pinDigest, and digest updates for all dependencies",
      "automerge": true,
      "matchUpdateTypes": ["pin", "pinDigest", "digest"]
    },
    {
      "description": "Enable GitHub Actions updates (they are container deps but should be managed)",
      "enabled": true,
      "matchDepTypes": ["container"],
      "matchFileNames": [".github/workflows/**.yaml", ".github/workflows/**.yml"],
      "matchDatasources": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Group container base image updates",
      "matchDepTypes": ["container"],
      "matchDatasources": ["docker"],
      "groupName": "base-images"
    },
    {
      "description": "Auto-merge updates for r2modmanPlus and Devsy RPMs)",
      "automerge": true,
      "matchFileNames": ["build_files/build.sh"],
      "matchDepNames": ["ebkr/r2modmanPlus", "devsy-org/devsy"],
      "matchUpdateTypes": ["patch", "minor","major"]
    },
    {
      "description": "Auto-merge updates for throttled",
      "automerge": true,
      "matchFileNames": ["build_files/build_thinkpad.sh"],
      "matchDepNames": ["erpalma/throttled"],
      "matchUpdateTypes": ["patch", "minor","major"]
    }
  ],

  "customManagers": [
    {
      // throttled's release URL contains the version twice (tag path + RPM filename),
      // so the match spans the whole URL and autoReplaceStringTemplate rewrites both
      // occurrences (the filename carries no "v" prefix).
      "customType": "regex",
      "managerFilePatterns": ["/build_files/build_thinkpad.sh/"],
      "matchStrings": [
        "erpalma/throttled/releases/download/v(?<version>[\\d.]+)/throttled-[\\d.]+\\-1.noarch\\.rpm"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "erpalma/throttled",
      "versioningTemplate": "semver-coerced",
      "currentValueTemplate": "v{{version}}",
      "autoReplaceStringTemplate": "erpalma/throttled/releases/download/{{newValue}}/throttled-{{replace \"^v\" \"\" newValue}}-1.noarch.rpm"
    },
    {
      // r2modman's release URL contains the version twice (tag path + RPM filename),
      // so the match spans the whole URL and autoReplaceStringTemplate rewrites both
      // occurrences (the filename carries no "v" prefix).
      "customType": "regex",
      "managerFilePatterns": ["/build_files/build.sh/"],
      "matchStrings": [
        "r2modmanPlus/releases/download/v(?<version>[\\d.]+)/r2modman-[\\d.]+\\.x86_64\\.rpm"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "ebkr/r2modmanPlus",
      "versioningTemplate": "semver",
      "currentValueTemplate": "v{{version}}",
      "autoReplaceStringTemplate": "r2modmanPlus/releases/download/{{newValue}}/r2modman-{{replace \"^v\" \"\" newValue}}.x86_64.rpm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/build_files/build.sh/"],
      "matchStrings": [
        "devsy-org/devsy/releases/download/v(?<version>[\\d.]+)/"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "devsy-org/devsy",
      "versioningTemplate": "semver",
      "currentValueTemplate": "v{{version}}"
    }
  ]
}
